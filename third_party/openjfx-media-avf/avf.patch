+// Watavyu patch: after a seek the old frame could stay on screen. The display link
+// may hand over a frame decoded before the seek but stamped with the new item time;
+// javafx.scene.media.MediaPlayer then skips the correct frame because its timestamp
+// is unchanged, and while paused nothing replaces it. Deliver the frame at the new
+// time directly, retrying briefly while it is decoded, with a timestamp nudged by
+// less than a microsecond so the renderer always uploads it. Then restart the display
+// link for any frames that follow. A newer seek supersedes this one.
+- (void) deliverFrameAfterSeek:(uint64_t)generation attempt:(int)attempt {
+    @synchronized(self) {
+        if (isDisposed || generation != _seekGeneration || self.playerOutput == nil) {
+            return;
+        }
+        CMTime itemTime = self.player.currentItem.currentTime;
+        CVPixelBufferRef buffer = [self.playerOutput copyPixelBufferForItemTime:itemTime itemTimeForDisplay:NULL];
+        if (buffer != NULL) {
+            double frameTime = CMTimeGetSeconds(itemTime) + SEEK_FRAME_TIME_NUDGE * (generation % 1000 + 1);
+            [self sendPixelBuffer:buffer frameTime:frameTime hostTime:CVGetCurrentHostTime()];
+            CVBufferRelease(buffer);
+            if (_displayLink != NULL) {
+                self.lastHostTime = CVGetCurrentHostTime();
+                CVDisplayLinkStart(_displayLink);
+            }
+            return;
+        }
+    }
+    if (attempt < SEEK_FRAME_ATTEMPTS) {
+        __weak AVFMediaPlayer *weakSelf = self;
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, SEEK_FRAME_RETRY_MSEC * NSEC_PER_MSEC), playerQueue, ^{
+            [weakSelf deliverFrameAfterSeek:generation attempt:attempt + 1];
+        });
+    }
+}
